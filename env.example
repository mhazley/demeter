# Copy to .env and fill in. Keep .env out of git.

# `id -u` / `id -g` of the user that owns /data
PUID=1000
PGID=1000
TZ=Europe/London

# Proton: account.protonvpn.com -> Downloads -> WireGuard configuration
#   Platform: Router (or GNU/Linux), enable "NAT-PMP (Port Forwarding)",
#   pick a P2P server, then copy the PrivateKey line from the generated config.
PROTON_WG_PRIVATE_KEY=
PROTON_SERVER_COUNTRIES=Netherlands,Switzerland

# API keys: Settings -> General in each *arr; Jellyfin Dashboard -> API Keys; Seerr Settings -> General
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
JELLYFIN_API_KEY=
SEERR_API_KEY=
QBIT_USER=
QBIT_PASS=

# Must match apikey in config/gluetun/auth/config.toml   (openssl rand -hex 24)
GLUETUN_CONTROL_KEY=
